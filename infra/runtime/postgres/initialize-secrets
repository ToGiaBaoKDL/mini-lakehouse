#!/bin/sh
set -eu

if [ "$#" -ne 1 ]; then
    printf '%s\n' "Usage: infra/runtime/postgres/initialize-secrets <bootstrap|airflow|lightdash|pg_monitor|t0_trading>" >&2
    exit 2
fi

credential=$1
case "$credential" in
    bootstrap | airflow | lightdash | pg_monitor | t0_trading) ;;
    *)
        printf '%s\n' "Unknown metadata database credential: $credential" >&2
        exit 2
        ;;
esac

command -v aws >/dev/null
command -v jq >/dev/null
command -v python3 >/dev/null
command -v sha256sum >/dev/null

environment=${LAKEHOUSE_ENVIRONMENT:-dev}
secret_id="lakehouse/$environment/metadata-postgres/$credential"
if current=$(aws secretsmanager get-secret-value \
    --secret-id "$secret_id" --query SecretString --output text 2>/dev/null); then
    printf '%s' "$current" | jq -e \
        '.version == 1 and (.password | type == "string" and length > 0)' >/dev/null || {
        printf '%s\n' "Secret $secret_id is not schema version 1." >&2
        exit 1
    }
    printf '%s\n' "Secret $secret_id is already initialized."
    exit 0
fi

aws secretsmanager describe-secret --secret-id "$secret_id" >/dev/null
secret_file=$(mktemp "${TMPDIR:-/tmp}/metadata-secret.XXXXXX")
trap 'rm -f "$secret_file"' EXIT HUP INT TERM
umask 077
python3 -c \
    'import json,secrets; print(json.dumps({"version":1,"password":secrets.token_urlsafe(32)}))' \
    >"$secret_file"
client_token=$(sha256sum "$secret_file" | cut -d ' ' -f 1)
aws secretsmanager put-secret-value \
    --secret-id "$secret_id" \
    --client-request-token "$client_token" \
    --secret-string "file://$secret_file" >/dev/null
printf '%s\n' "Initialized $secret_id."
