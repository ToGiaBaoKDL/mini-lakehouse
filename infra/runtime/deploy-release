#!/bin/sh
set -eu

usage() {
    printf '%s\n' "Usage: deploy-release <environment> <identity-dir> <release> <bind-address>"
    exit 2
}

environment="${1:-}"
identity_dir="${2:-}"
release="${3:-}"
bind_address="${4:-}"
[ -n "$environment" ] && [ -n "$identity_dir" ] && [ -n "$release" ] && [ -n "$bind_address" ] || usage

config="$identity_dir/services-deployer/host-config"
[ -r "$config" ] || {
    printf '%s\n' "Missing services-deployer identity: $config"
    exit 1
}
command -v aws >/dev/null
command -v docker >/dev/null
command -v jq >/dev/null
command -v make >/dev/null

aws_runtime() {
    env -u AWS_ACCESS_KEY_ID -u AWS_SECRET_ACCESS_KEY -u AWS_SESSION_TOKEN \
        AWS_CONFIG_FILE="$config" AWS_PROFILE=default aws "$@"
}

manifest="$(aws_runtime ssm get-parameter \
    --name "/lakehouse/$environment/deployment/release_manifest" \
    --query Parameter.Value --output text)"
printf '%s' "$manifest" | jq -e \
    --arg release "$release" \
    '.version == 1 and .release == $release and
     ([.images.airflow, .images["arxiv-inspector"], .images["dbt-task"], .images["ocr-worker"]]
      | all(type == "string" and length > 0))' >/dev/null

airflow_image="$(printf '%s' "$manifest" | jq -er '.images.airflow')"
inspector_image="$(printf '%s' "$manifest" | jq -er '.images["arxiv-inspector"]')"
dbt_image="$(printf '%s' "$manifest" | jq -er '.images["dbt-task"]')"
ocr_image="$(printf '%s' "$manifest" | jq -er '.images["ocr-worker"]')"
registry="${airflow_image%%/*}"

aws_runtime ecr get-login-password | docker login \
    --username AWS --password-stdin "$registry" >/dev/null

previous_service_image() {
    container="$(docker ps -a \
        --filter "label=com.docker.compose.project=$1" \
        --filter "label=com.docker.compose.service=$2" \
        --format '{{.ID}}' | sed -n '1p')"
    if [ -n "$container" ]; then
        docker inspect --format '{{.Config.Image}}' "$container"
    fi
}

previous_airflow="$(previous_service_image airflow airflow-api-server)"
previous_inspector="$(previous_service_image arxiv-inspector arxiv-inspector)"
previous_dbt="$(docker image inspect --format '{{.Id}}' dbt-task:runtime 2>/dev/null || true)"
previous_ocr="$(docker image inspect --format '{{.Id}}' ocr-worker:runtime 2>/dev/null || true)"
deployment_started=false

rollback() {
    status=$?
    trap - EXIT HUP INT TERM
    if [ "$deployment_started" = true ]; then
        printf '%s\n' "Release failed; restoring the previous healthy service images."
        if [ -n "$previous_dbt" ]; then docker tag "$previous_dbt" dbt-task:runtime; fi
        if [ -n "$previous_ocr" ]; then docker tag "$previous_ocr" ocr-worker:runtime; fi
        if [ -n "$previous_airflow" ] && [ -n "$previous_inspector" ]; then
            make services-up \
                AWS_IDENTITY_DIR="$identity_dir" \
                HOST_BIND_ADDRESS="$bind_address" \
                AIRFLOW_IMAGE="$previous_airflow" \
                ARXIV_INSPECTOR_IMAGE="$previous_inspector" || true
        else
            make services-down \
                AWS_IDENTITY_DIR="$identity_dir" \
                HOST_BIND_ADDRESS="$bind_address" || true
        fi
    fi
    exit "$status"
}
trap rollback EXIT HUP INT TERM

for image in "$airflow_image" "$inspector_image" "$dbt_image" "$ocr_image"; do
    docker pull "$image"
done

deployment_started=true
make services-up \
    AWS_IDENTITY_DIR="$identity_dir" \
    HOST_BIND_ADDRESS="$bind_address" \
    AIRFLOW_IMAGE="$airflow_image" \
    ARXIV_INSPECTOR_IMAGE="$inspector_image"

docker tag "$dbt_image" dbt-task:runtime
docker tag "$ocr_image" ocr-worker:runtime
deployment_started=false
trap - EXIT HUP INT TERM
printf '%s\n' "Deployed release $release."
