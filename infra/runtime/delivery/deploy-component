#!/bin/sh
set -eu

if [ "$#" -ne 2 ]; then
    printf '%s\n' "Usage: deploy-component <component> <image@sha256:digest>" >&2
    exit 2
fi

component=$1
image=$2
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
bundle_root=$(CDPATH= cd -- "$script_dir/../../.." && pwd)

export LAKEHOUSE_ENVIRONMENT=${LAKEHOUSE_ENVIRONMENT:-dev}
export AWS_IDENTITY_DIR=${AWS_IDENTITY_DIR:-"$HOME/.config/lakehouse/$LAKEHOUSE_ENVIRONMENT/aws"}
export HOST_BIND_ADDRESS=${HOST_BIND_ADDRESS:-0.0.0.0}

case "$component" in
    airflow)
        export AIRFLOW_BASE_URL=${AIRFLOW_BASE_URL:-https://airflow.tgblab.io.vn}
        deploy="$bundle_root/orchestration/deploy/deploy"
        ;;
    arxiv-inspector)
        deploy="$bundle_root/apps/arxiv_inspector/deploy/deploy"
        ;;
    cloudflare)
        deploy="$bundle_root/infra/runtime/cloudflare/deploy"
        ;;
    dbt-task)
        deploy="$bundle_root/dbt/analytics/deploy/deploy"
        ;;
    ocr-worker)
        deploy="$bundle_root/ocr/deploy/deploy"
        ;;
    *)
        printf '%s\n' "Unknown component: $component" >&2
        exit 2
        ;;
esac

"$deploy" "$image"
printf '%s\n' "Deployed $component as $image"
