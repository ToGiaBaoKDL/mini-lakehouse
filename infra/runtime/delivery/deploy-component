#!/bin/sh
set -eu

if [ "$#" -ne 2 ]; then
    printf '%s\n' "Usage: deploy-component <component> <image@sha256:digest>" >&2
    exit 2
fi

component=$1
image=$2
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
bundle_root=$(CDPATH= cd -- "$script_dir/../../.." && pwd)

export LAKEHOUSE_ENVIRONMENT=${LAKEHOUSE_ENVIRONMENT:-dev}
export AWS_IDENTITY_DIR=${AWS_IDENTITY_DIR:-"$HOME/.config/lakehouse/$LAKEHOUSE_ENVIRONMENT/aws"}
export HOST_BIND_ADDRESS=${HOST_BIND_ADDRESS:-0.0.0.0}

case "$component" in
    airflow)
        export AIRFLOW_BASE_URL=${AIRFLOW_BASE_URL:-https://airflow.tgblab.io.vn}
        deploy="$bundle_root/automation/airflow/deploy/deploy"
        ;;
    arxiv-lens)
        deploy="$bundle_root/arxiv-lens/deploy/deploy"
        ;;
    cloudflare)
        deploy="$bundle_root/infra/runtime/cloudflare/deploy"
        ;;
    lightdash)
        export LIGHTDASH_SITE_URL=${LIGHTDASH_SITE_URL:-https://analytics.tgblab.io.vn}
        deploy="$bundle_root/analytics/lightdash/deploy/deploy"
        ;;
    lakehouse-ingest)
        deploy="$bundle_root/lakehouse/ingest/deploy/deploy"
        ;;
    netdata)
        deploy="$bundle_root/sysops/netdata/deploy"
        ;;
    dbt)
        deploy="$bundle_root/analytics/dbt-project/deploy/deploy"
        ;;
    t0-trading)
        deploy="$bundle_root/t0-trading/deploy/deploy"
        ;;
    *)
        printf '%s\n' "Unknown component: $component" >&2
        exit 2
        ;;
esac

"$deploy" "$image"
printf '%s\n' "Deployed $component as $image"
