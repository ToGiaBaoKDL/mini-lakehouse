#!/bin/sh
set -eu

if [ "$#" -ne 3 ]; then
    printf '%s\n' "Usage: infra/runtime/cloudflare/sync-secret <account-id> <tunnel-id> <aws-secret-id>" >&2
    exit 2
fi
test -n "${CLOUDFLARE_API_TOKEN:-}" || {
    printf '%s\n' "CLOUDFLARE_API_TOKEN is required." >&2
    exit 1
}

account_id=$1
tunnel_id=$2
secret_id=$3
printf '%s' "$account_id" | grep -Eq '^[0-9a-f]{32}$' || {
    printf '%s\n' "Invalid Cloudflare account ID." >&2
    exit 2
}
printf '%s' "$tunnel_id" \
    | grep -Eq '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$' \
    || {
    printf '%s\n' "Invalid Cloudflare Tunnel ID." >&2
    exit 2
}
test -n "$secret_id" || {
    printf '%s\n' "AWS secret ID must not be empty." >&2
    exit 2
}

response=$(curl -fsS \
    -H "Authorization: Bearer $CLOUDFLARE_API_TOKEN" \
    "https://api.cloudflare.com/client/v4/accounts/$account_id/cfd_tunnel/$tunnel_id/token")
token=$(printf '%s' "$response" | jq -er \
    'if .success == true and (.result | type == "string" and length > 0) then .result else error("Cloudflare did not return a tunnel token") end')
payload=$(jq -cn --arg token "$token" '{version: 1, token: $token}')
current=$(AWS_PAGER= aws secretsmanager get-secret-value \
    --secret-id "$secret_id" --query SecretString --output text 2>/dev/null || true)

if [ "$current" = "$payload" ]; then
    printf '%s\n' "Cloudflare Tunnel secret is already current."
    exit 0
fi

printf '%s' "$payload" \
    | AWS_PAGER= aws secretsmanager put-secret-value \
        --secret-id "$secret_id" --secret-string file:///dev/stdin >/dev/null
printf '%s\n' "Cloudflare Tunnel secret synchronized."
