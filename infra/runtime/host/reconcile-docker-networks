#!/bin/sh
set -eu

test "$(id -u)" -eq 0 || {
    printf '%s\n' "reconcile-docker-networks must run as root." >&2
    exit 1
}

network=lakehouse-observability
subnet=172.24.0.0/16
gateway=172.24.0.1
exec 9>/run/lock/lakehouse-docker-networks.lock
flock 9

if docker network inspect "$network" >/dev/null 2>&1; then
    test "$(docker network inspect -f '{{.Driver}}' "$network")" = bridge || {
        printf '%s\n' "$network exists but is not a bridge network." >&2
        exit 1
    }
    ipam_count=$(docker network inspect -f '{{len .IPAM.Config}}' "$network")
    test "$ipam_count" = 1 || {
        printf '%s\n' \
            "$network has $ipam_count IPAM entries; expected exactly one." >&2
        exit 1
    }
    actual_subnet=$(docker network inspect -f '{{(index .IPAM.Config 0).Subnet}}' "$network")
    actual_gateway=$(docker network inspect -f '{{(index .IPAM.Config 0).Gateway}}' "$network")
    test "$actual_subnet" = "$subnet" \
        && test "$actual_gateway" = "$gateway" || {
        printf '%s\n' \
            "$network has unexpected IPAM: subnet=$actual_subnet gateway=$actual_gateway (expected $subnet via $gateway)." >&2
        exit 1
    }
    printf '%s\n' "$network is current."
    exit 0
fi

docker network create \
    --driver bridge \
    --subnet "$subnet" \
    --gateway "$gateway" \
    --opt com.docker.network.bridge.name=br-lh-observe \
    --label lakehouse.owner=services-host \
    "$network" >/dev/null
printf '%s\n' "$network created."
