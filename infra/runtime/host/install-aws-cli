    "https://awscli.amazonaws.com/awscli-exe-linux-$distribution_architecture-$version.zip.sig" \
    -o "$signature"
gpg --batch --homedir "$gnupg_home" --verify "$signature" "$archive" >/dev/null 2>&1
unzip -q "$archive" -d "$working_dir"

update=""
if [ -x /usr/local/aws-cli/v2/current/bin/aws ]; then
    update="--update"
fi
"$working_dir/aws/install" \
    --install-dir /usr/local/aws-cli \
    --bin-dir /usr/local/bin \
    $update

aws --version 2>&1 | grep -q "aws-cli/$version "
