#!/bin/sh
set -eu

version="2.36.11"
signing_key_fingerprint="FB5DB77FD5C118B80511ADA8A6310ACC4672475C"
architecture="${1:-$(uname -m)}"
case "$architecture" in
    arm64 | aarch64)
        distribution_architecture="aarch64"
        ;;
    *)
        printf '%s\n' "Unsupported architecture: $architecture" >&2
        exit 2
        ;;
esac

if command -v aws >/dev/null 2>&1 && aws --version 2>&1 | grep -q "aws-cli/$version "; then
    exit 0
fi

command -v curl >/dev/null
command -v gpg >/dev/null
command -v unzip >/dev/null

working_dir=$(mktemp -d "${TMPDIR:-/tmp}/aws-cli.XXXXXX")
cleanup() {
    rm -rf "$working_dir"
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM

archive="$working_dir/awscliv2.zip"
signature="$archive.sig"
public_key="$working_dir/aws-cli-team.asc"
