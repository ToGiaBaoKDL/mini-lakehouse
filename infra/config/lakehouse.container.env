LAKEHOUSE_ENVIRONMENT=local
LAKEHOUSE_LOG_LEVEL=INFO
LAKEHOUSE_CONTRACTS_DIR=/app/contracts
LAKEHOUSE_STORAGE__BACKEND=s3
LAKEHOUSE_STORAGE__ENDPOINT_URL=http://object-store:9000
LAKEHOUSE_STORAGE__REGION=us-east-1
LAKEHOUSE_STORAGE__PATH_STYLE_ACCESS=true
LAKEHOUSE_STORAGE__ICEBERG_ACCESS_DELEGATION=none
LAKEHOUSE_STORAGE__STS_UNAVAILABLE=true
LAKEHOUSE_STORAGE__KMS_UNAVAILABLE=true
LAKEHOUSE_STORAGE__LANDING_URI=s3://landing
LAKEHOUSE_STORAGE__CURATED_URI=s3://curated
LAKEHOUSE_STORAGE__ANALYTICS_URI=s3://analytics
LAKEHOUSE_POLARIS__CATALOG_NAME=prod
LAKEHOUSE_POLARIS__URI=http://polaris:8181/api/catalog
LAKEHOUSE_POLARIS__MANAGEMENT_URI=http://polaris:8181/api/management/v1
LAKEHOUSE_POLARIS__OAUTH2_SERVER_URI=http://polaris:8181/api/catalog/v1/oauth/tokens
LAKEHOUSE_POLARIS__SCOPE=PRINCIPAL_ROLE:ALL
LAKEHOUSE_TRINO__HOST=trino
LAKEHOUSE_TRINO__PORT=8080
LAKEHOUSE_TRINO__USER=lakehouse
LAKEHOUSE_TRINO__CATALOG=prod
LAKEHOUSE_TRINO__HTTP_SCHEME=http
LAKEHOUSE_DBT__PROJECT_DIR=/app/dbt/analytics
LAKEHOUSE_DBT__PROFILES_DIR=/app/dbt/analytics
DBT_TARGET=local
DBT_THREADS=4
LAKEHOUSE_NOTIFICATIONS__PREFECT_UI_URL=http://localhost:4200
