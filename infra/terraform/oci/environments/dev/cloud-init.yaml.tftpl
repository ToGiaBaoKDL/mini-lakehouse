#cloud-config
package_update: true
packages:
  - ca-certificates
  - curl
  - docker.io
  - docker-compose-v2
  - gnupg
  - jq
  - python3-minimal
  - unzip

write_files:
  - path: /run/tailscale-auth-key
    owner: root:root
    permissions: "0600"
    content: ${tailscale_auth_key}
  - path: /usr/local/sbin/install-aws-signing-helper
    owner: root:root
    permissions: "0755"
    content: |
      ${signing_helper_installer}
  - path: /usr/local/sbin/install-aws-cli
    owner: root:root
    permissions: "0755"
    content: |
      ${aws_cli_installer}
  - path: /usr/local/sbin/install-tailscale
    owner: root:root
    permissions: "0755"
    content: |
      ${tailscale_installer}

runcmd:
  - /usr/local/sbin/install-tailscale
  - systemctl enable --now docker tailscaled
  - /usr/local/sbin/install-aws-cli "$(uname -m)"
  - /usr/local/sbin/install-aws-signing-helper "$(uname -m)"
  - usermod -aG docker ubuntu
  - tailscale up --auth-key=file:/run/tailscale-auth-key --hostname=${hostname} --ssh
  - shred -u /run/tailscale-auth-key
