aws_profile = "your-aws-profile"
document_inspector_access = {
  databases        = ["curated_arxiv"]
  curated_prefixes = ["arxiv"]
}
alert_email   = "data-platform@example.com"
slack_channel = "#data-platform-alerts"

# A single developer role may assume every workload in dev. Use distinct
# service and operator identities when the workloads run independently.
trusted_principals = {
  airflow            = ["arn:aws:iam::123456789012:role/Developer"]
  catalog_admin      = ["arn:aws:iam::123456789012:role/Developer"]
  dbt_transformer    = ["arn:aws:iam::123456789012:role/Developer"]
  document_inspector = ["arn:aws:iam::123456789012:role/Developer"]
  emr_deployer       = ["arn:aws:iam::123456789012:role/Developer"]
}
