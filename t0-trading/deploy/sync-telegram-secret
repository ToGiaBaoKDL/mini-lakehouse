#!/bin/sh
set -eu

if [ "$#" -ne 1 ]; then
    printf '%s\n' "Usage: t0-trading/deploy/sync-telegram-secret <payload-file>" >&2
    exit 2
fi

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
payload_file=$1
test -f "$payload_file" && test -r "$payload_file" || {
    printf '%s\n' "Telegram payload must be a readable regular file." >&2
    exit 1
}
test -z "$(find "$payload_file" -prune -perm /077 -print)" || {
    printf '%s\n' "Telegram payload must not be accessible by group or other users." >&2
    exit 1
}
jq -ce -f "$script_dir/telegram-secret.jq" "$payload_file" >/dev/null
environment=${LAKEHOUSE_ENVIRONMENT:-dev}
secret_id="lakehouse/$environment/t0-trading/telegram"
AWS_PAGER= aws secretsmanager describe-secret --secret-id "$secret_id" >/dev/null
client_token=$(jq -c -f "$script_dir/telegram-secret.jq" "$payload_file" | sha256sum | cut -d ' ' -f 1)
jq -c -f "$script_dir/telegram-secret.jq" "$payload_file" | AWS_PAGER= aws secretsmanager put-secret-value \
    --secret-id "$secret_id" \
    --client-request-token "$client_token" \
    --secret-string file:///dev/stdin >/dev/null
printf '%s\n' "Synchronized $secret_id."
