#!/bin/sh
set -eu

if [ "$#" -ne 1 ]; then
    printf '%s\n' "Usage: t0-trading/deploy/sync-ssi-secret <payload-file>" >&2
    exit 2
fi

command -v aws >/dev/null
command -v jq >/dev/null
command -v sha256sum >/dev/null

payload_file=$1
test -f "$payload_file" && test -r "$payload_file" || {
    printf '%s\n' "SSI credential payload is not a readable regular file: $payload_file" >&2
    exit 1
}
test -z "$(find "$payload_file" -prune -perm /077 -print)" || {
    printf '%s\n' "SSI credential payload must not be accessible by group or other users." >&2
    exit 1
}
jq -e '
    type == "object" and
    .version == 1 and
    (.client_id | type == "string" and length > 0) and
    (.api_key | type == "string" and length > 0) and
    (.api_secret | type == "string" and length > 0) and
    (keys | sort == ["api_key", "api_secret", "client_id", "version"])
' "$payload_file" >/dev/null || {
    printf '%s\n' "SSI credential must contain only version 1 and populated v3 credential fields." >&2
    exit 1
}

environment=${LAKEHOUSE_ENVIRONMENT:-dev}
secret_id="lakehouse/$environment/t0-trading/ssi"
AWS_PAGER= aws secretsmanager describe-secret --secret-id "$secret_id" >/dev/null
client_token=$(jq -c '{version, client_id, api_key, api_secret}' "$payload_file" | sha256sum | cut -d ' ' -f 1)
jq -c '{version, client_id, api_key, api_secret}' "$payload_file" | AWS_PAGER= aws secretsmanager put-secret-value \
    --secret-id "$secret_id" \
    --client-request-token "$client_token" \
    --secret-string file:///dev/stdin >/dev/null
printf '%s\n' "Synchronized $secret_id."
