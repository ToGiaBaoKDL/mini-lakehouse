#!/bin/sh
set -eu

if [ "$#" -gt 1 ]; then
    printf '%s\n' "Usage: orchestration/deploy/reconcile [airflow-image]" >&2
    exit 2
fi

image=${1:-airflow:local}
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
bundle_root=$(CDPATH= cd -- "$script_dir/../.." && pwd)
environment=${LAKEHOUSE_ENVIRONMENT:-dev}
identity_dir=${AWS_IDENTITY_DIR:-"$HOME/.config/lakehouse/$environment/aws"}
host_config="$identity_dir/airflow/host-config"

"$bundle_root/infra/runtime/postgres/deploy"
test -r "$host_config" || {
    printf '%s\n' "The airflow host identity config is missing." >&2
    exit 1
}
test -r "$identity_dir/airflow/config" || {
    printf '%s\n' "The airflow container identity config is missing." >&2
    exit 1
}

aws_runtime() {
    env -u AWS_ACCESS_KEY_ID -u AWS_SECRET_ACCESS_KEY -u AWS_SESSION_TOKEN \
        AWS_CONFIG_FILE="$host_config" AWS_PROFILE=default aws "$@"
}

runtime_secret=$(aws_runtime secretsmanager get-secret-value \
    --secret-id "lakehouse/$environment/airflow/runtime" \
    --query SecretString --output text)
database_secret=$(aws_runtime secretsmanager get-secret-value \
    --secret-id "lakehouse/$environment/metadata-postgres/airflow" \
    --query SecretString --output text)
remote_log_uri=$(aws_runtime ssm get-parameter \
    --name "/lakehouse/$environment/airflow/remote_log_uri" \
    --query Parameter.Value --output text)

printf '%s' "$runtime_secret" | jq -e \
    '.version == 1 and ([.fernet_key, .jwt_secret, .admin_password] | all(type == "string" and length > 0))' \
    >/dev/null
printf '%s' "$database_secret" | jq -e \
    '.version == 1 and (.password | type == "string" and length > 0)' >/dev/null

export LAKEHOUSE_ENVIRONMENT=$environment
export AWS_IDENTITY_DIR=$identity_dir
export HOST_BIND_ADDRESS=${HOST_BIND_ADDRESS:-127.0.0.1}
export AIRFLOW_BASE_URL=${AIRFLOW_BASE_URL:-"http://$HOST_BIND_ADDRESS:8080"}
export LOCAL_UID=${LOCAL_UID:-$(id -u)}
export DOCKER_GID=${DOCKER_GID:-$(stat -c '%g' /var/run/docker.sock)}
export AIRFLOW_IMAGE=$image
export AIRFLOW_REMOTE_LOG_URI=$remote_log_uri
AIRFLOW_DATABASE_PASSWORD=$(printf '%s' "$database_secret" | jq -r '.password')
AIRFLOW_FERNET_KEY=$(printf '%s' "$runtime_secret" | jq -r '.fernet_key')
AIRFLOW_JWT_SECRET=$(printf '%s' "$runtime_secret" | jq -r '.jwt_secret')
AIRFLOW_ADMIN_PASSWORDS=$(printf '%s' "$runtime_secret" | jq -c '{admin: .admin_password}')
export AIRFLOW_DATABASE_PASSWORD AIRFLOW_FERNET_KEY AIRFLOW_JWT_SECRET AIRFLOW_ADMIN_PASSWORDS

docker compose --project-name airflow -f "$script_dir/compose.yaml" \
    up -d --force-recreate --wait --wait-timeout 300
