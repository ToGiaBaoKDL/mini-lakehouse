#!/bin/sh
set -eu

if [ "$#" -ne 1 ]; then
    printf '%s\n' "Usage: ocr/deploy/deploy <image@sha256:digest>" >&2
    exit 2
fi

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
bundle_root=$(CDPATH= cd -- "$script_dir/../.." && pwd)
"$bundle_root/infra/runtime/delivery/pull-image" ocr-worker "$1"
docker tag "$1" ocr-worker:runtime
