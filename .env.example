# AWS credential chain. Keep keys out of this file; use an AWS profile or workload role.
AWS_CONFIG_DIR=./.aws
AWS_REGION=ap-southeast-1
AIRFLOW_AWS_PROFILE=lakehouse-dev-airflow
CATALOG_ADMIN_AWS_PROFILE=lakehouse-dev-catalog-admin
DBT_AWS_PROFILE=lakehouse-dev-dbt-transformer
DOCUMENT_INSPECTOR_AWS_PROFILE=lakehouse-dev-document-inspector
EMR_DEPLOYER_AWS_PROFILE=lakehouse-dev-emr-deployer

LAKEHOUSE_ENVIRONMENT=dev
LAKEHOUSE_LOG_LEVEL=INFO

# Self-hosted Airflow metadata only. Generate strong local values before starting.
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=replace-with-random-password
AIRFLOW_JWT_SECRET=replace-with-random-secret
AIRFLOW_FERNET_KEY=replace-with-a-fernet-key
AIRFLOW_USERS=admin:admin
AIRFLOW_PARALLELISM=4
AIRFLOW_CONNECTIONS_PREFIX=lakehouse/dev/airflow/connections
AIRFLOW_VARIABLES_PREFIX=/lakehouse/dev

# OCR providers remain optional and are not part of the AWS platform migration.
# KAGGLE_USERNAME=your-kaggle-user
# KAGGLE_API_TOKEN=your-kaggle-api-token
# MODAL_TOKEN_ID=your-modal-token-id
# MODAL_TOKEN_SECRET=your-modal-token-secret
