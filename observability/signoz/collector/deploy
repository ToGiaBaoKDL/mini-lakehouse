#!/bin/sh
set -eu

if [ "$#" -ne 1 ]; then
    printf '%s\n' "Usage: observability/signoz/collector/deploy <collection-agent-image@sha256:digest>" >&2
    exit 2
fi

image=$1
printf '%s' "$image" \
    | grep -Eq '^otel/opentelemetry-collector-contrib:[0-9]+\.[0-9]+\.[0-9]+@sha256:[0-9a-f]{64}$' \
    || {
    printf '%s\n' "Image must be a versioned otel/opentelemetry-collector-contrib digest." >&2
    exit 2
}

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
bundle_root=$(CDPATH= cd -- "$script_dir/../../.." && pwd)
expected_image=$(cat "$script_dir/image")
test "$image" = "$expected_image" || {
    printf '%s\n' "Image does not match the reviewed collection-agent release." >&2
    exit 2
}

environment=${LAKEHOUSE_ENVIRONMENT:-dev}
identity_dir=${AWS_IDENTITY_DIR:-"$HOME/.config/lakehouse/$environment/aws"}
host_config="$identity_dir/metadata-postgres/host-config"
test -r "$host_config" || {
    printf '%s\n' "The metadata-postgres workload identity is missing." >&2
    exit 1
}

docker compose version >/dev/null 2>&1 || {
    printf '%s\n' "Docker Compose is required on the services host." >&2
    exit 1
}
docker network inspect signoz-network >/dev/null 2>&1 || {
    printf '%s\n' "signoz-network is missing; deploy the SigNoz stack first (foundryctl cast)." >&2
    exit 1
}
docker network inspect lakehouse-metadata >/dev/null 2>&1 || {
    printf '%s\n' "lakehouse-metadata is missing; deploy metadata PostgreSQL first." >&2
    exit 1
}

aws_runtime() {
    env -u AWS_ACCESS_KEY_ID -u AWS_SECRET_ACCESS_KEY -u AWS_SESSION_TOKEN \
        AWS_SHARED_CREDENTIALS_FILE=/dev/null \
        AWS_CONFIG_FILE="$host_config" AWS_PROFILE=default AWS_PAGER= aws "$@"
}

monitor_secret=$(aws_runtime secretsmanager get-secret-value \
    --secret-id "lakehouse/$environment/metadata-postgres/pg_monitor" \
    --query SecretString --output text)
printf '%s' "$monitor_secret" | jq -e \
    '.version == 1 and (.password | type == "string" and length > 0)' >/dev/null

# Reconcile the pg_monitor role idempotently through the PostgreSQL bootstrap
# boundary before the agent depends on it.
"$bundle_root/infra/runtime/postgres/deploy" pg_monitor

export COLLECTOR_IMAGE=$image
export OTEL_RESOURCE_ATTRIBUTES=${OTEL_RESOURCE_ATTRIBUTES:-deployment.environment=dev}
export POSTGRES_MONITOR_ENDPOINT=${POSTGRES_MONITOR_ENDPOINT:-metadata-postgres:5432}
PG_MONITOR_USER=$(printf '%s' "$monitor_secret" | jq -r '.username // "pg_monitor_user"')
PG_MONITOR_PASSWORD=$(printf '%s' "$monitor_secret" | jq -r '.password')
export PG_MONITOR_USER PG_MONITOR_PASSWORD

docker pull "$image" >/dev/null
docker compose --project-name signoz-collection-agent -f "$script_dir/compose.yaml" \
    up -d --force-recreate

attempt=0
until [ "$(docker inspect -f '{{.State.Running}}' signoz-collection-agent 2>/dev/null)" = "true" ] \
    && sleep 5 \
    && [ "$(docker inspect -f '{{.State.Running}}' signoz-collection-agent 2>/dev/null)" = "true" ]; do
    attempt=$((attempt + 1))
    if [ "$attempt" -ge 6 ]; then
        docker compose --project-name signoz-collection-agent -f "$script_dir/compose.yaml" \
            logs --tail=100
        printf '%s\n' "SigNoz collection agent did not stay running within 30 seconds." >&2
        exit 1
    fi
    sleep 2
done

printf '%s\n' "SigNoz collection agent is running."
