#!/bin/sh
set -eu

if [ "$#" -ne 1 ]; then
    printf '%s\n' "Usage: docs/deploy/sync-ci-secret <payload-file>" >&2
    exit 2
fi

command -v aws >/dev/null
command -v jq >/dev/null
command -v sha256sum >/dev/null

payload_file=$1
test -r "$payload_file" || {
    printf '%s\n' "Cloudflare docs CI secret payload is not readable: $payload_file" >&2
    exit 1
}
jq -e '
    .version == 1 and
    (.api_token | type == "string") and
    (.api_token | length > 0) and
    (keys | sort == ["api_token", "version"])
' "$payload_file" >/dev/null || {
    printf '%s\n' "Cloudflare docs CI secret must contain only version 1 and a populated api_token." >&2
    exit 1
}

environment=${LAKEHOUSE_ENVIRONMENT:-dev}
secret_id="lakehouse/$environment/cloudflare/docs-ci"
AWS_PAGER= aws secretsmanager describe-secret --secret-id "$secret_id" >/dev/null
client_token=$(sha256sum "$payload_file" | cut -d ' ' -f 1)
AWS_PAGER= aws secretsmanager put-secret-value \
    --secret-id "$secret_id" \
    --client-request-token "$client_token" \
    --secret-string "file://$payload_file" >/dev/null
printf '%s\n' "Synchronized $secret_id."
