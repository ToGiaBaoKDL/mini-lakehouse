{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "import", "nextjs"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "builtin": true
  },
  "settings": {
    "react": {
      "version": "19.2.8"
    },
    "tailwindcss": {
      "callees": ["clsx", "cva", "cn"]
    }
  },
  "ignorePatterns": [".next/", ".source/", "node_modules/", "out/"]
}
