{
  "name": "mini-lakehouse-docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build": "fumadocs-mdx && next build",
    "check": "pnpm lint && pnpm typecheck && pnpm links && pnpm build",
    "deploy": "wrangler deploy",
    "dev": "next dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "links": "node --import tsx scripts/validate-links.ts",
    "postinstall": "fumadocs-mdx",
    "preview": "wrangler dev",
    "lint": "oxlint --deny-warnings && pnpm format:check",
    "typecheck": "fumadocs-mdx && next typegen && tsc --noEmit"
  },
  "dependencies": {
    "fumadocs-core": "16.15.2",
    "fumadocs-mdx": "15.3.1",
    "fumadocs-ui": "16.15.2",
    "lucide-react": "1.34.0",
    "mermaid": "11.17.2",
    "next": "16.3.3",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "next-validate-link": "1.6.7",
    "oxlint": "1.80.0",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "wrangler": "4.126.0"
  }
}
