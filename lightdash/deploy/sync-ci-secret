#!/bin/sh
set -eu

if [ "$#" -ne 1 ]; then
    printf '%s\n' "Usage: lightdash/deploy/sync-ci-secret <payload-file>" >&2
    exit 2
fi

command -v aws >/dev/null
command -v jq >/dev/null
command -v sha256sum >/dev/null

payload_file=$1
test -r "$payload_file" || {
    printf '%s\n' "Lightdash CI secret payload is not readable: $payload_file" >&2
    exit 1
}
jq -e '
    .version == 1 and
    (.api_key | type == "string") and
    (.api_key | length > 0) and
    (.api_key | startswith("ldpat_")) and
    (keys | sort == ["api_key", "version"])
' "$payload_file" >/dev/null || {
    printf '%s\n' "Lightdash CI secret must contain only version 1 and a populated ldpat_ api_key." >&2
    exit 1
}

environment=${LAKEHOUSE_ENVIRONMENT:-dev}
secret_id="lakehouse/$environment/lightdash/ci"
aws secretsmanager describe-secret --secret-id "$secret_id" >/dev/null
client_token=$(sha256sum "$payload_file" | cut -d ' ' -f 1)
aws secretsmanager put-secret-value \
    --secret-id "$secret_id" \
    --client-request-token "$client_token" \
    --secret-string "file://$payload_file" >/dev/null
printf '%s\n' "Synchronized $secret_id."
